    {
      "path": ".research/briefs/agentic-prioritization-hygiene-landscape.md",
      "namespace": "research",
      "kind": "research-brief",
      "id": "agentic-prioritization-hygiene-landscape",
      "title": "Agentic Prioritization and Backlog Hygiene: A Landscape",
      "summary": "In agentic coding systems, queue priority is a structural property of the task graph (dependency readiness, critical-path depth, deadline urgency) rather than a semantic business-value score; backlog hygiene inverts from batched ceremony to continuous automated detection.",
      "updated": "2026-06-15",
      "status": null,
      "relationships": []
    },
    {
      "path": ".research/briefs/backlog-grooming-discipline-landscape.md",
      "namespace": "research",
      "kind": "research-brief",
      "id": "backlog-grooming-discipline-landscape",
      "title": "Backlog Grooming Discipline: Landscape Brief",
      "summary": "Established backlog-grooming discipline (DEEP criteria, refinement-as-ongoing-activity, zombie-item detection, anti-patterns) is well-settled in human-team practice; mechanizable detection reduces to date/metadata arithmetic plus NLP-assisted duplicate detection, with all sources converging on propose-not-prune.",
      "updated": "2026-06-15",
      "status": null,
      "relationships": []
    },
    {
      "path": ".research/briefs/okf-adoption-landscape.md",
      "namespace": "research",
      "kind": "research-brief",
      "id": "okf-adoption-landscape",
      "title": "OKF adoption landscape — five weeks post-announcement",
      "summary": "Early OKF adoption is real but limited, and its strongest architectural signal is a storage format paired with a separate trust, governance, and retrieval layer.",
      "updated": "2026-07-20",
      "status": null,
      "relationships": []
    },
    {
      "path": ".research/briefs/okf-format-assessment-against-ard-substrate.md",
      "namespace": "research",
